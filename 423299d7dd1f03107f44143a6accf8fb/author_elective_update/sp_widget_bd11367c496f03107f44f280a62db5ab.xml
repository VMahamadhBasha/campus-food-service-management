        <script><![CDATA[(function() {

    data.tickets = [];


    var gr = new GlideRecord("incident");


    gr.addQuery(
        "caller_id",
        gs.getUserID()
    );


    gr.orderByDesc("sys_created_on");

    gr.query();


    while (gr.next()) {

        var ticket = {};


        ticket.number =
            gr.getValue("number");


        ticket.subject =
            gr.getValue("short_description");


        ticket.date =
            gr.getDisplayValue("sys_created_on");


        var state =
            gr.getValue("state");


        if (state == "1") {

            ticket.status = "Open";

        } else if (state == "2") {

            ticket.status = "In Progress";

        } else {

            ticket.status = "Closed";

        }


        data.tickets.push(ticket);

    }

})();]]></script>
