        <script><![CDATA[(function() {

    if (input && input.action == "submit") {

        var gr = new GlideRecord("u_food_complaint");

        gr.initialize();

        gr.u_complaint_type = input.complaint_type;
        gr.u_mess_hall = input.mess_hall;
        gr.u_meal = input.meal;
        gr.u_description = input.description;

        gr.insert();

        data.message = "Complaint submitted successfully!";

    }

})();]]></script>
