        <template><![CDATA[<div class="cfsa-complaint">

  <div class="complaint-header">
    <h2>]]>🍽<![CDATA[️ Campus Food Complaint</h2>
    <p>Report any food-related issue</p>
  </div>

  <div class="complaint-body">

    <div class="form-group">
      <label>Complaint Type</label>
      <select class="form-control"
              ng-model="c.data.complaint_type">
        <option value="">Select Complaint Type</option>
        <option value="Stale Food">Stale Food</option>
        <option value="Poor Food Quality">Poor Food Quality</option>
        <option value="Bad Taste">Bad Taste</option>
        <option value="Food Hygiene Issue">Food Hygiene Issue</option>
        <option value="Food Quantity Issue">Food Quantity Issue</option>
        <option value="Late Food Service">Late Food Service</option>
        <option value="Other">Other</option>
      </select>
    </div>

    <div class="form-group">
      <label>Mess Hall</label>
      <select class="form-control"
              ng-model="c.data.mess_hall">
        <option value="">Select Mess Hall</option>
        <option value="Mess Hall A">Mess Hall A</option>
        <option value="Mess Hall B">Mess Hall B</option>
        <option value="Mess Hall C">Mess Hall C</option>
      </select>
    </div>

    <div class="form-group">
      <label>Meal</label>
      <select class="form-control"
              ng-model="c.data.meal">
        <option value="">Select Meal</option>
        <option value="Breakfast">Breakfast</option>
        <option value="Lunch">Lunch</option>
        <option value="Snacks">Snacks</option>
        <option value="Dinner">Dinner</option>
      </select>
    </div>

    <div class="form-group">
      <label>Complaint Description</label>
      <textarea class="form-control"
                rows="4"
                ng-model="c.data.description"
                placeholder="Describe your complaint">
      </textarea>
    </div>

    <div class="form-group">
      <label>Food Photo</label>
      <input type="file"
             class="form-control"
             accept="image/*">
      <small>Upload a photo of the food issue</small>
    </div>

    <button class="btn btn-primary"
            ng-click="c.submitComplaint()">
      Submit Complaint
    </button>

    <div class="alert alert-success"
         ng-if="c.data.message">
      {{c.data.message}}
    </div>

  </div>

</div>]]></template>
    </sp_widget>
