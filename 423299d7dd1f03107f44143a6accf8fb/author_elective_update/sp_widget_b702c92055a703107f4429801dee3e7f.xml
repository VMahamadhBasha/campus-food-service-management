&#13;
.student-widget h2 {&#13;
    text-align: center;&#13;
    margin-bottom: 20px;&#13;
}&#13;
&#13;
.student-widget p {&#13;
    text-align: center;&#13;
    font-size: 16px;&#13;
}&#13;
&#13;
.student-widget .form-control {&#13;
    width: 100%;&#13;
    padding: 12px;&#13;
    border: 1px solid #ccc;&#13;
    border-radius: 6px;&#13;
}&#13;
&#13;
.student-widget .btn-primary {&#13;
    width: 100%;&#13;
    padding: 12px;&#13;
    border: none;&#13;
    border-radius: 6px;&#13;
    background: #337ab7;&#13;
    color: white;&#13;
    cursor: pointer;&#13;
}&#13;
&#13;
.student-widget .btn-primary:hover {&#13;
    background: #286090;&#13;
}</css>
